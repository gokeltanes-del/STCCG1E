<Window x:Class="StarTrekCCG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Phase 0 Test" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Seite: Suche + Liste -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Kartensuche" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="SearchBox" 
                         Height="32" 
                         FontSize="14"
                         Padding="6,4"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="StatusText" 
                           Foreground="#AAAAAA" 
                           Margin="0,8,0,0" 
                           Text="Noch keine Daten geladen"/>
            </StackPanel>

            <ListBox x:Name="CardList" 
                     Background="#2D2D2D" 
                     Foreground="White"
                     BorderThickness="0"
                     SelectionChanged="CardList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Margin="4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Rechte Seite: Detailansicht -->
        <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name + Typ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="CardNameText" 
                               Text="Keine Karte ausgewählt" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="CardTypeText" 
                               FontSize="14" 
                               Foreground="#4EC9B0" 
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="CardSetText" 
                               FontSize="12" 
                               Foreground="#888888" 
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bild + Text nebeneinander -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            BorderBrush="#555" 
                            BorderThickness="1" 
                            Margin="0,0,20,0"
                            Background="#1A1A1A">
                        <Image x:Name="CardImage" 
                               Width="280" 
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Gametext" Foreground="#CE9178" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="CardTextBlock" 
                                       Foreground="#D4D4D4" 
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="22"/>

                            <TextBlock Text="Lore" Foreground="#CE9178" FontWeight="SemiBold" Margin="0,20,0,6"/>
                            <TextBlock x:Name="CardLoreBlock" 
                                       Foreground="#9CDCFE" 
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Unten: Attribute (einfach) -->
                <TextBlock x:Name="AttributesText" 
                           Grid.Row="2" 
                           Foreground="#B5CEA8" 
                           Margin="0,16,0,0"
                           FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>
