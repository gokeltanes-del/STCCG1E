<Window x:Class="StarTrekCCG.BoosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premiere booster"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E22"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LobbyChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,20" Background="#1E1E22" BorderBrush="#3A3A48" BorderThickness="0">
        <StackPanel>
            <TextBlock Text="Premiere booster" Foreground="#EEE" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="The server draws 15 cards. This window does not choose them."
                       Foreground="#AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="LatinumText" Text="Latinum: " Foreground="#EEE" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="PriceText" Text="Price: 50 latinum. 1 Rare, 3 Uncommon, 11 Common."
                       Foreground="#EEE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button x:Name="BuyButton" Content="Buy Premiere booster" Click="BuyButton_Click"
                    Height="32" HorizontalAlignment="Stretch" Cursor="Hand" Margin="0,0,0,10"
                    Background="#3A3A48" Foreground="#EEE" BorderBrush="#3A3A48" BorderThickness="0"/>
            <TextBlock x:Name="NoteText" Text="" Foreground="#EEE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="CardsBox" Height="300" IsReadOnly="True" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
        </StackPanel>
    </Border>
</Window>
