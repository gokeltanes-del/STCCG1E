<Window x:Class="StarTrekCCG.DeckBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Deck Builder"
        Height="860" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SkinBrush_WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeSkin.xaml"/>
                <ResourceDictionary Source="LobbyChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SkinStyle_DeckListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="2,1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E3348"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A4A66"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid x:Name="Shell" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="FilterRegion" Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Card browser" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <CheckBox x:Name="AccountOnlyCheck" Content="Nur Konto-Karten"
                              Foreground="White" Margin="0,0,0,4"
                              Checked="CatalogFilter_Changed" Unchecked="CatalogFilter_Changed"/>
                    <CheckBox x:Name="UnlockAllCheck" Content="Alle Karten (Holodeck)"
                              Foreground="White" Margin="0,0,0,10"
                              Checked="CatalogFilter_Changed" Unchecked="CatalogFilter_Changed"/>

                    <TextBlock Text="Search" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="SearchBox" Height="28" FontSize="13" Padding="6,3"
                             TextChanged="FilterChanged" Margin="0,0,0,8"/>

                    <TextBlock Text="Sets" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="All" Click="SetFilterAll_Click"
                                Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                                Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button DockPanel.Dock="Right" Content="None" Click="SetFilterNone_Click"
                                Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                                Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button DockPanel.Dock="Right" x:Name="SetFilterPhysicalBtn" Content="[P]" Click="SetFilterPhysical_Click"
                                Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                                Style="{StaticResource SkinStyle_ActionMiniButton}"
                                ToolTip="Physical (Decipher) sets only"/>
                        <Button DockPanel.Dock="Right" x:Name="SetFilterVirtualBtn" Content="[V]" Click="SetFilterVirtual_Click"
                                Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                                Style="{StaticResource SkinStyle_ActionMiniButton}"
                                ToolTip="Virtual (CC) sets only"/>
                        <TextBlock x:Name="SetFilterSummary" Text="All sets" Foreground="{StaticResource SkinBrush_CyanAccent}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="{StaticResource SkinBrush_CenterBackground}" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1"
                            Height="120" Margin="0,0,0,8" CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SetFilterPanel" Margin="4"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Type" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="TypeFilter" Height="28" Margin="0,0,0,8" SelectionChanged="TypeFilter_Changed"/>

                    <StackPanel x:Name="AffiliationFilterPanel">
                        <TextBlock x:Name="AffiliationFilterLabel" Text="Affiliation"
                                   Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="AffiliationFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="QuadrantFilterPanel">
                        <TextBlock Text="Quadrant" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="QuadrantFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="SkillFilterPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Class / Skills" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Clear" Height="20" Padding="8,0"
                                    FontSize="10" Click="ClearSkillFilters_Click" Cursor="Hand" Margin="6,0,0,0"
                                    Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                            <TextBlock x:Name="SkillFilterSummary" DockPanel.Dock="Right"
                                       Text="" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </DockPanel>
                        <WrapPanel x:Name="SkillCatButtons" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource SkinBrush_CenterBackground}" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1"
                                MaxHeight="140" CornerRadius="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="SkillFilterHost" Margin="4"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Sort" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="SortFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="12" Text="No cards loaded" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="CardListRegion" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0"
                    Background="{StaticResource SkinBrush_RailBackground}"
                    BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1" CornerRadius="6" Padding="6">
                <ListBox x:Name="CardList" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                     SelectionChanged="CardList_SelectionChanged"
                     MouseDoubleClick="CardList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#EEE"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Unowned}" Value="True">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A4A66"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding NameBrush, Mode=OneWay}"/>
                                <TextBlock Text="{Binding PoolLabel, Mode=OneWay}" Foreground="#9CDCFE" FontSize="10"
                                           Visibility="{Binding PoolVisibility, Mode=OneWay}"/>
                                <TextBlock Foreground="#888" FontSize="11">
                                    <Run Text="{Binding Type, Mode=OneWay}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding Affiliation, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#6A9" FontSize="10">
                                    <Run Text="{Binding Quadrant, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Region, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="DeckRegion" Grid.Row="0" Grid.Column="2" Margin="0,0,8,0"
                    Background="{StaticResource SkinBrush_CenterBackground}"
                    BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Current deck" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="DeckNameBox" Height="28" FontSize="13" Padding="6,3" Text="New deck" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Save" Width="90" Height="28" Margin="0,0,6,0" Click="SaveDeck_Click" Style="{StaticResource SkinStyle_SciFiButton}"/>
                            <Button Content="Load" Width="70" Height="28" Margin="0,0,6,0" Click="LoadDeck_Click" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                            <Button Content="Clear" Width="70" Height="28" Click="ClearDeck_Click" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        </StackPanel>
                        <CheckBox x:Name="IgnoreRulesCheck" Content="Dev: ignore construction rules"
                                  Foreground="#DCDCAA" FontSize="11" Margin="0,0,0,8"
                                  ToolTip="Off = Compendium limits (seed 30, 6 missions, Tent 13 unique, Site 6, type piles). On = add anything for testing."/>
                        <TextBlock x:Name="DeckCountText" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="11"
                                   Text="Seed 0  •  Draw 0  •  Side 0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="AccountPickPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="Konto-Decks" Foreground="White" Margin="0,0,0,4"/>
                            <ListBox x:Name="AccountPickList" Height="140" Background="{StaticResource SkinBrush_CenterBackground}" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Load" Width="70" Height="26" Margin="0,0,6,0" Click="AccountPickOk_Click" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                                <Button Content="Abbrechen" Width="90" Height="26" Click="AccountPickCancel_Click" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TabControl x:Name="DeckTabs" Background="Transparent" BorderThickness="0"
                                Margin="0,0,0,8" SelectionChanged="DeckTabs_SelectionChanged" DockPanel.Dock="Top">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="MinWidth" Value="72"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#00000000"
                                                    BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,4,4" Opacity="0.72">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SkinBrush_GoldAccent}"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,3"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <TabItem x:Name="SeedTab" Header="Seed" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="DrawTab" Header="Draw" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="QsTentTab" Header="Q's Tent" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="BattleBridgeTab" Header="B.Bridge" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="QContinuumTab" Header="Q-Cont." Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="SitePileTab" Header="Sites" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="TribbleTab" Header="Tribble" Background="{StaticResource SkinBrush_HeaderBackground}"/>
                        <TabItem x:Name="SideLegacyTab" Header="Side legacy" Background="{StaticResource SkinBrush_HeaderBackground}" Visibility="Collapsed"/>
                    </TabControl>
                    <ListBox x:Name="DeckList" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" ItemContainerStyle="{StaticResource SkinStyle_DeckListItem}"
                         SelectionChanged="DeckList_SelectionChanged"
                         KeyDown="DeckList_KeyDown"
                         MouseDoubleClick="DeckList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#888" FontSize="11" Text="{Binding Type, Mode=OneWay}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0}x}"
                                               FontWeight="Bold" Foreground="{StaticResource SkinBrush_CyanAccent}" VerticalAlignment="Center"
                                               Margin="8,0,4,0"/>
                                    </Grid>
                                    <UniformGrid x:Name="ItemActions" Columns="5" Margin="0,8,0,2" Visibility="Collapsed">
                                        <Button Content="−1" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Click="DecreaseQuantity_Click"/>
                                        <Button Content="Remove" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Click="RemoveFromDeck_Click"/>
                                        <Button Content="→ Seed" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="Seed" Click="MoveToSeed_Click"/>
                                        <Button Content="→ Draw" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="Draw" Click="MoveToDraw_Click"/>
                                        <Button Content="→ Q's Tent" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="QsTent" Click="MoveToQsTent_Click"/>
                                        <Button Content="→ B.Bridge" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="BattleBridge" Click="MoveToBattleBridge_Click"/>
                                        <Button Content="→ Q-Cont." Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="QContinuum" Click="MoveToQContinuum_Click"/>
                                        <Button Content="→ Sites" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="SitePile" Click="MoveToSitePile_Click"/>
                                        <Button Content="→ Tribble" Height="26" Margin="1" FontSize="11" Style="{StaticResource SkinStyle_ActionMiniButton}"
                                            Tag="Tribble" Click="MoveToTribble_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                        <Setter TargetName="ItemActions" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="DetailRegion" Grid.Row="0" Grid.Column="3"
                    Background="{StaticResource SkinBrush_RailBackground}"
                    BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="CardNameText" Text="No card selected" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CardTypeText" FontSize="13" Foreground="{StaticResource SkinBrush_CyanAccent}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CardSetText" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1" Margin="0,0,0,8" Background="{StaticResource SkinBrush_CenterBackground}" HorizontalAlignment="Left">
                                <Image x:Name="CardImage" Width="200" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                                       MouseLeftButtonDown="CardImage_MouseLeftButtonDown"
                                       ToolTip="Click for large view"/>
                            </Border>
                            <TextBlock x:Name="AttributesHeader" Text="Attribute" Foreground="#CE9178" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed"/>
                            <TextBlock x:Name="AttributesText" Foreground="#B5CEA8" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ClassText" Foreground="#DCDCAA" FontSize="13" Margin="0,0,0,3"/>
                            <WrapPanel x:Name="StaffRow" Margin="0,2,0,2"/>
                            <WrapPanel x:Name="IconRow" Margin="0,2,0,6"/>
                            <TextBlock x:Name="StaffText" Foreground="#9CDCFE" FontSize="13" Margin="0,0,0,3"/>
                            <TextBlock x:Name="IconsText" Foreground="#C586C0" FontSize="13" Margin="0,0,0,3"/>
                            <TextBlock x:Name="CharacteristicsText" Foreground="#888888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="MissionInfoText" Foreground="#4EC9B0" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GametextLabel" Text="Gametext" Foreground="#CE9178" FontWeight="SemiBold" Margin="0,8,0,4" Visibility="Collapsed"/>
                            <TextBlock x:Name="CardTextBlock" Foreground="#D4D4D4" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="ActionRegion" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                    Background="{StaticResource SkinBrush_FooterBackground}"
                    BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Add all visible" Click="AddAllVisible_Click" Height="32" MinWidth="180" Margin="0,0,12,0"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            ToolTip="Adds every card in the filtered list once to the currently selected deck tab."/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                        <Button Width="56" Height="26" Margin="3,0" IsEnabled="False" Style="{StaticResource SkinStyle_ActionMiniButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="CardZoomOverlay" Background="#E60B1017" Visibility="Collapsed" Panel.ZIndex="100" MouseLeftButtonDown="CloseCardZoom_Click">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="CardZoomImage" MaxHeight="720" MaxWidth="500" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="CardZoomCaption" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Click or press Esc to close" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
