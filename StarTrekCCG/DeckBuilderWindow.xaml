<Window x:Class="StarTrekCCG.DeckBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Deck Builder"
        Height="860" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid Margin="12" x:Name="MainLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LINKE SPALTE: Kartensuche + Filter ========== -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Card browser" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Search" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="SearchBox" Height="28" FontSize="13" Padding="6,3"
                         TextChanged="FilterChanged" Margin="0,0,0,8"/>

                    <TextBlock Text="Sets" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="All" Click="SetFilterAll_Click"
                            Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                            Background="#3A3A48" Foreground="White" BorderThickness="0"/>
                        <Button DockPanel.Dock="Right" Content="None" Click="SetFilterNone_Click"
                            Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                            Background="#3A3A48" Foreground="White" BorderThickness="0"/>
                        <Button DockPanel.Dock="Right" x:Name="SetFilterPhysicalBtn" Content="[P]" Click="SetFilterPhysical_Click"
                            Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                            Background="#2A4A3A" Foreground="White" BorderThickness="0"
                            ToolTip="Physical (Decipher) sets only"/>
                        <Button DockPanel.Dock="Right" x:Name="SetFilterVirtualBtn" Content="[V]" Click="SetFilterVirtual_Click"
                            Padding="8,2" Margin="4,0,0,0" Cursor="Hand"
                            Background="#3A2A4A" Foreground="White" BorderThickness="0"
                            ToolTip="Virtual (CC) sets only"/>
                        <TextBlock x:Name="SetFilterSummary" Text="All sets" Foreground="#9CDCFE"
                               FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="#2A2A2E" BorderBrush="#444" BorderThickness="1"
                        Height="88" Margin="0,0,0,8" CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SetFilterPanel" Margin="4"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Type" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="TypeFilter" Height="28" Margin="0,0,0,8" SelectionChanged="TypeFilter_Changed"/>

                    <StackPanel x:Name="AffiliationFilterPanel">
                        <TextBlock x:Name="AffiliationFilterLabel" Text="Affiliation"
                               Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="AffiliationFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="QuadrantFilterPanel">
                        <TextBlock Text="Quadrant" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="QuadrantFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- Personnel skill / icon: category buttons, then only the active group -->
                    <StackPanel x:Name="SkillFilterPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Skills / Icons" Foreground="#AAAAAA" FontSize="11"
                                   VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Clear" Height="20" Padding="8,0"
                                FontSize="10" Background="#555" Foreground="White" BorderThickness="0"
                                Click="ClearSkillFilters_Click" Cursor="Hand" Margin="6,0,0,0"/>
                            <TextBlock x:Name="SkillFilterSummary" DockPanel.Dock="Right"
                                   Text="" Foreground="#4EC9B0" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </DockPanel>
                        <WrapPanel x:Name="SkillCatButtons" Margin="0,0,0,4"/>
                        <Border Background="#2A2A2E" BorderBrush="#444" BorderThickness="1"
                            MaxHeight="110" CornerRadius="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="SkillFilterHost" Margin="4"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Sort" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="SortFilter" Height="28" Margin="0,0,0,8" SelectionChanged="FilterChanged"/>

                    <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="12" Text="No cards loaded"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Add all visible → active pile"
                    Click="AddAllVisible_Click" Height="32" Margin="0,8,0,0"
                    Background="#0E639C" Foreground="White" BorderThickness="0" Cursor="Hand"
                    ToolTip="Adds every card in the filtered list once to the currently selected deck tab."/>
                <ListBox x:Name="CardList" Background="#2D2D2D" Foreground="White" BorderThickness="0"
                     SelectionChanged="CardList_SelectionChanged"
                     MouseDoubleClick="CardList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#888" FontSize="11">
                                <Run Text="{Binding Type}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding Affiliation}"/>
                                </TextBlock>
                                <TextBlock Foreground="#6A9" FontSize="10">
                                <Run Text="{Binding Quadrant}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Region}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ========== MITTLERE SPALTE: Kartendetail + Add-Buttons ========== -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="CardNameText" Text="No card selected"
                               FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CardTypeText" FontSize="13" Foreground="#4EC9B0" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CardSetText" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1" Margin="0,0,14,0" Background="#1A1A1A"
                            VerticalAlignment="Top">
                            <Image x:Name="CardImage" Width="220" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Cursor="Hand"
                               MouseLeftButtonDown="CardImage_MouseLeftButtonDown"
                               ToolTip="Double-click for large view"/>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="AttributesHeader" Text="Attribute" Foreground="#CE9178"
                                       FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed"/>
                                <TextBlock x:Name="AttributesText" Foreground="#B5CEA8" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock x:Name="ClassText" Foreground="#DCDCAA" FontSize="13" Margin="0,0,0,3"/>
                                <WrapPanel x:Name="StaffRow" Margin="0,2,0,2"/>
                                <WrapPanel x:Name="IconRow" Margin="0,2,0,6"/>
                                <TextBlock x:Name="StaffText" Foreground="#9CDCFE" FontSize="13" Margin="0,0,0,3"/>
                                <TextBlock x:Name="IconsText" Foreground="#C586C0" FontSize="13" Margin="0,0,0,3"/>
                                <TextBlock x:Name="CharacteristicsText" Foreground="#888888" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock x:Name="MissionInfoText" Foreground="#4EC9B0" FontSize="13"
                                       Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <TextBlock x:Name="GametextLabel" Text="Gametext" Foreground="#CE9178" FontWeight="SemiBold" Margin="0,8,0,4" Visibility="Collapsed"/>
                                <TextBlock x:Name="CardTextBlock" Foreground="#D4D4D4" TextWrapping="Wrap"
                                       FontSize="13" LineHeight="20"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Border>

            <!-- ========== RECHTE SPALTE: Deck mit Tabs ========== -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="6" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Current deck" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBox x:Name="DeckNameBox" Height="28" FontSize="13" Padding="6,3"
                             Text="New deck" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Save" Width="90" Height="28" Margin="0,0,6,0"
                                Click="SaveDeck_Click" Background="#388A34" Foreground="White" BorderThickness="0"/>
                            <Button Content="Load" Width="70" Height="28" Margin="0,0,6,0"
                                Click="LoadDeck_Click" Background="#555" Foreground="White" BorderThickness="0"/>
                            <Button Content="Clear" Width="70" Height="28"
                                Click="ClearDeck_Click" Background="#8B3A3A" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                        <CheckBox x:Name="IgnoreRulesCheck" Content="Dev: ignore construction rules"
                              Foreground="#DCDCAA" FontSize="11" Margin="0,0,0,8"
                              ToolTip="Off = Compendium limits (seed 30, 6 missions, Tent 13 unique, Site 6, type piles). On = add anything for testing."/>

                        <TextBlock x:Name="DeckCountText" Foreground="#4EC9B0" FontSize="11"
                               Text="Seed 0  •  Draw 0  •  Side 0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TabControl x:Name="DeckTabs" Background="#1E1E1E" BorderThickness="0"
                            Margin="0,0,0,8" SelectionChanged="DeckTabs_SelectionChanged"
                            DockPanel.Dock="Top">
                        <TabControl.Resources>
                            <!-- Base template; Background from TabItem.Background -->
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="MinWidth" Value="72"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#00000000"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="0,0,4,4"
                                                Opacity="0.72">
                                                <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,3"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem x:Name="SeedTab" Header="Seed" Background="#0E639C"/>
                        <TabItem x:Name="DrawTab" Header="Draw" Background="#2E7D32"/>
                        <TabItem x:Name="QsTentTab" Header="Q's Tent" Background="#6A1B9A"/>
                        <TabItem x:Name="BattleBridgeTab" Header="B.Bridge" Background="#B71C1C"/>
                        <TabItem x:Name="QContinuumTab" Header="Q-Cont." Background="#5E35B1"/>
                        <TabItem x:Name="SitePileTab" Header="Sites" Background="#00838F"/>
                        <TabItem x:Name="TribbleTab" Header="Tribble" Background="#EF6C00"/>
                        <TabItem x:Name="SideLegacyTab" Header="Side alt" Background="#555555" Visibility="Collapsed"/>
                    </TabControl>

                    <ListBox x:Name="DeckList" Background="#1E1E1E" Foreground="White" BorderThickness="0"
                         SelectionChanged="DeckList_SelectionChanged"
                         KeyDown="DeckList_KeyDown"
                         MouseDoubleClick="DeckList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#888" FontSize="11" Text="{Binding Type}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0}x}"
                                               FontWeight="Bold" Foreground="#4EC9B0" VerticalAlignment="Center"
                                               Margin="8,0,4,0"/>
                                    </Grid>
                                    <UniformGrid x:Name="ItemActions" Columns="5" Margin="0,8,0,2" Visibility="Collapsed">
                                        <Button Content="−1" Height="26" Margin="1" FontSize="11"
                                            Click="DecreaseQuantity_Click" Background="#555" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Remove" Height="26" Margin="1" FontSize="11"
                                            Click="RemoveFromDeck_Click" Background="#8B3A3A" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Seed" Height="26" Margin="1" FontSize="11"
                                            Tag="Seed" Click="MoveToSeed_Click" Background="#0E639C" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Draw" Height="26" Margin="1" FontSize="11"
                                            Tag="Draw" Click="MoveToDraw_Click" Background="#2E7D32" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Q's Tent" Height="26" Margin="1" FontSize="11"
                                            Tag="QsTent" Click="MoveToQsTent_Click" Background="#6A1B9A" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ B.Bridge" Height="26" Margin="1" FontSize="11"
                                            Tag="BattleBridge" Click="MoveToBattleBridge_Click" Background="#B71C1C" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Q-Cont." Height="26" Margin="1" FontSize="11"
                                            Tag="QContinuum" Click="MoveToQContinuum_Click" Background="#5E35B1" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Sites" Height="26" Margin="1" FontSize="11"
                                            Tag="SitePile" Click="MoveToSitePile_Click" Background="#00838F" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="→ Tribble" Height="26" Margin="1" FontSize="11"
                                            Tag="Tribble" Click="MoveToTribble_Click" Background="#EF6C00" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                    </UniformGrid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                        <Setter TargetName="ItemActions" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="CardZoomOverlay" Background="#E6000000" Visibility="Collapsed"
          Panel.ZIndex="100" MouseLeftButtonDown="CloseCardZoom_Click">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="CardZoomImage" MaxHeight="720" MaxWidth="500"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="CardZoomCaption" Foreground="White" FontSize="16"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Click or press Esc to close" Foreground="#AAA"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>