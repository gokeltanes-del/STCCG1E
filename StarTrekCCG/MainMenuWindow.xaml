<Window x:Class="StarTrekCCG.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Main Bridge"
        Height="900" Width="1680"
        MinHeight="768" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SkinBrush_WindowBackground}"
        Loaded="MainMenuWindow_Loaded"
        Closing="MainMenuWindow_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeSkin.xaml"/>
                <ResourceDictionary Source="LobbyChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Overall Window Structure: Follows TableWindow.xaml coordinates and layout zones -->
    <DockPanel LastChildFill="True">

        <!-- ========================================================================= -->
        <!-- ZONE_TOPBAR (Top Status Bar)                                              -->
        <!-- Coordinates & Geometry: Full Width, MinHeight ~44px                       -->
        <!-- ========================================================================= -->
        <Border x:Name="Zone_TopBar"
                DockPanel.Dock="Top"
                Background="{StaticResource SkinBrush_HeaderBarGradient}"
                BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                BorderThickness="0,0,0,2"
                MinHeight="44"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Player Name & Rank & Faction -->
                    <ColumnDefinition Width="*"/>    <!-- Center dynamic banner / spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Login/Logout & Online Indicator -->
                </Grid.ColumnDefinitions>

                <!-- Left: Profile Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerNameText"
                               Text="CAPTAIN RIX"
                               Foreground="#FFFFFF"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " Foreground="#64748B" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="PlayerRankText"
                               Text="CADET"
                               Foreground="#94A3B8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " Foreground="#64748B" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="PlayerFactionText"
                               Text="FEDERATION"
                               Foreground="#38BDF8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Auth Button & Online Status LED -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAuthSwitch"
                            Content="LOGIN"
                            Click="BtnAuthSwitch_Click"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Height="28"
                            Padding="12,2"
                            Margin="0,0,16,0"/>

                    <Ellipse x:Name="OnlineIndicatorLight"
                             Width="10"
                             Height="10"
                             Fill="{StaticResource SkinBrush_GreenOnline}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>

                    <TextBlock x:Name="OnlineStatusText"
                               Text="online"
                               Foreground="#E2E8F0"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- CORE BODY GRID (Left Rail, Center Main Screen, Right Rail)                -->
        <!-- Widths: LeftRail 156px, Center *, RightRail 260px (matches TableWindow)   -->
        <!-- ========================================================================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftRailColumn" Width="156"/> <!-- ZONE_LEFTRAIL -->
                <ColumnDefinition Width="*"/>   <!-- ZONE_CENTER_MAIN & ZONE_BOTTOM_SOCIAL -->
                <ColumnDefinition Width="260"/> <!-- ZONE_RIGHTRAIL -->
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- ZONE_LEFTRAIL (156px)                                                 -->
            <!-- ===================================================================== -->
            <Border Grid.Column="0"
                    Background="{StaticResource SkinBrush_RailBackground}"
                    BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                    BorderThickness="0,0,2,0"
                    Padding="8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Upper 5 buttons -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Lower 2 buttons (Lounge, Friends) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Upper 5 Buttons: PLAY, COLLECTION, DECKS, CAREER, OPTIONS -->
                    <UniformGrid x:Name="NavButtonGrid" Grid.Row="0" Columns="1" Margin="0,0,0,10">
                        <Button x:Name="BtnNavPlay"
                                Content="PLAY"
                                Click="BtnNavPlay_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnNavCollection"
                                Content="COLLECTION"
                                Click="BtnNavCollection_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnNavDecks"
                                Content="DECKS"
                                Click="BtnNavDecks_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnNavCareer"
                                Content="CAREER"
                                Click="BtnNavCareer_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnNavOptions"
                                Content="OPTIONS"
                                Click="BtnNavOptions_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                    </UniformGrid>

                    <UniformGrid x:Name="PlayChoiceGrid" Grid.Row="0" Columns="1" Margin="0,0,0,10" Visibility="Collapsed">
                        <Button x:Name="BtnNavSingleplayer"
                                Content="SINGLEPLAYER"
                                Click="BtnNavSingleplayer_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnNavMultiplayer"
                                Content="MULTIPLAYER"
                                Click="BtnNavMultiplayer_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                    </UniformGrid>

                    <UniformGrid x:Name="CrewRailGrid" Grid.Row="0" Columns="1" Margin="0,0,0,10" Visibility="Collapsed">
                        <Button x:Name="BtnRailLounge"
                                Content="LOUNGE"
                                Click="BtnRailLounge_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                        <Button x:Name="BtnRailFriends"
                                Content="FRIENDS"
                                Click="BtnRailFriends_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Margin="2,4"/>
                    </UniformGrid>

                    <Separator x:Name="NavRailSeparator" Grid.Row="1" Background="{StaticResource SkinBrush_InnerFrame}" Margin="4,4,4,10"/>

                    <!-- Lower 2 Buttons: LOUNGE, FRIENDS -->
                    <StackPanel x:Name="LoungeButtonStack" Grid.Row="2" Orientation="Vertical">
                        <Button x:Name="BtnNavLounge"
                                Content="LOUNGE"
                                Click="BtnNavLounge_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Height="42"
                                Margin="2,3"/>
                        <Button x:Name="BtnNavFriends"
                                Content="FRIENDS"
                                Click="BtnNavFriends_Click"
                                Style="{StaticResource SkinStyle_SciFiButton}"
                                Height="42"
                                Margin="2,3"/>
                    </StackPanel>
                    <Grid x:Name="DeckFilterHost" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- ZONE_CENTER_MAIN & ZONE_BOTTOM_SOCIAL                                 -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DeckListColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>     <!-- ZONE_CENTER_MAIN (Dynamic Viewscreen) -->
                    <RowDefinition Height="152"/>   <!-- ZONE_BOTTOM_SOCIAL (crew + reserve slots) -->
                </Grid.RowDefinitions>

                <Grid x:Name="DeckListHost" Grid.Row="0" Grid.Column="0" Margin="8,8,0,4" Visibility="Collapsed"/>

                <!-- 1. Center Main Screen (Dynamic Content Area) -->
                <Border Grid.Row="0" Grid.Column="1"
                        Margin="8,8,8,4"
                        Background="{StaticResource SkinBrush_CenterBackground}"
                        BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                        BorderThickness="2"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Simulated / Fallback Deep Space Viewscreen Background -->
                        <Grid x:Name="SpaceBackdropGrid">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.65" RadiusY="0.55">
                                    <GradientStop Color="#1E3A5F" Offset="0"/>
                                    <GradientStop Color="#0F1F38" Offset="0.35"/>
                                    <GradientStop Color="#080D16" Offset="0.8"/>
                                    <GradientStop Color="#03060B" Offset="1"/>
                                </RadialGradientBrush>
                            </Grid.Background>
                            
                            <!-- Star nebula decorative element -->
                            <Border Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="400">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#D97706" Offset="0"/>
                                        <GradientStop Color="#0284C7" Offset="0.45"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Viewscreen content is created in code and removed when that screen is left. -->
                        <Grid x:Name="DynamicViewHost"/>

                            <!-- 2. Integrated Match Preparation / Network Lobby Console -->
                            <Grid x:Name="MatchLobbyGrid" Margin="16,10,16,10" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header bar with title, badge and back button -->
                                    <RowDefinition Height="*"/>    <!-- Two-column console -->
                                </Grid.RowDefinitions>

                                <!-- Top Bar: Title, Protocol Mode Badge & Return to Bridge -->
                                <Border Grid.Row="0"
                                        Background="#D00D1826"
                                        BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,8"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mode Badge & Title -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="MATCH CONSOLE"
                                                       Foreground="{StaticResource SkinBrush_CyanAccent}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  ·  " Foreground="#64748B" VerticalAlignment="Center" FontSize="13"/>
                                            <Border x:Name="LobbyModeBadgeBorder"
                                                    Background="#2B394A"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="LobbyModeBadgeText"
                                                           Text="OFFICIAL MATCH (RANKED)"
                                                           Foreground="#FDE047"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Center Sub-status -->
                                        <TextBlock x:Name="LobbyConsoleSubTitle"
                                                   Grid.Column="1"
                                                   Text="Configure decks and readiness for subspace network engagement"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <!-- Right: Return to Bridge -->
                                        <Button x:Name="BtnLobbyBackToBridge"
                                                Grid.Column="2"
                                                Content="◀ RETURN TO BRIDGE"
                                                Click="BtnLobbyBackToBridge_Click"
                                                Style="{StaticResource SkinStyle_SciFiButton}"
                                                Height="28"
                                                Padding="12,2"/>
                                    </Grid>
                                </Border>

                                <!-- Main Console Body -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>     <!-- Left: Deck, Readiness, Skip-Seed & Launch -->
                                        <ColumnDefinition Width="0"/>   <!-- Right column removed from this screen. Relay and direct code stay. -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Station & Readiness -->
                                    <Border Grid.Column="0"
                                            Background="#D00D1826"
                                            BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,6,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="TACTICAL DECK &amp; STATION READINESS"
                                                           Foreground="{StaticResource SkinBrush_CyanAccent}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,10"/>

                                                <!-- Your Deck Selection -->
                                                <TextBlock Text="YOUR DECK" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="DeckCombo"
                                                              Height="30"
                                                              Margin="0,0,8,0"
                                                              SelectionChanged="DeckCombo_SelectionChanged"/>
                                                    <Button x:Name="BtnBrowseDeck"
                                                            Grid.Column="1"
                                                            Content="Browse…"
                                                            Height="30"
                                                            MinWidth="84"
                                                            Cursor="Hand"
                                                            Click="BtnBrowseDeck_Click"
                                                            Style="{StaticResource SkinStyle_SciFiButton}"/>
                                                </Grid>

                                                <!-- Station Readiness & Opponent State -->
                                                <Border Background="#141E2B"
                                                        BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,10"
                                                        Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="STATION STATUS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="LobbyReadyText"
                                                                   Text="You: not ready (no deck)"
                                                                   Foreground="#FDE047"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="LobbyPeerText"
                                                                   Text="Waiting for opponent connection…"
                                                                   Foreground="#CBD5E1"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Skip Seed Phase Consensus Box (Visible when both ready) -->
                                                <Border x:Name="SkipSeedPanel"
                                                        Background="#1A2D20"
                                                        BorderBrush="#2E7D32"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,10"
                                                        Margin="0,0,0,12"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="SKIP SEED PHASE CONSENSUS"
                                                                   Foreground="#4ADE80"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="SkipSeedStatusText"
                                                                   Text="Both ready — propose skip seed phase or choose manual seed."
                                                                   Foreground="#CBD5E1"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="BtnSkipSeedPropose"
                                                                    Content="Skip seed phase"
                                                                    Height="28"
                                                                    MinWidth="120"
                                                                    Margin="0,0,8,0"
                                                                    Cursor="Hand"
                                                                    Background="#2E7D32"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    Click="BtnSkipSeedPropose_Click"/>
                                                            <Button x:Name="BtnSkipSeedAccept"
                                                                    Content="Accept"
                                                                    Height="28"
                                                                    MinWidth="72"
                                                                    Margin="0,0,8,0"
                                                                    Cursor="Hand"
                                                                    Background="#0E639C"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    Visibility="Collapsed"
                                                                    Click="BtnSkipSeedAccept_Click"/>
                                                            <Button x:Name="BtnSkipSeedDecline"
                                                                    Content="Manual seed"
                                                                    Height="28"
                                                                    MinWidth="96"
                                                                    Cursor="Hand"
                                                                    Background="#5A2A2A"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    Click="BtnSkipSeedDecline_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Engagement & Game Launch Actions -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnStartGame"
                                                            Content="ENGAGE / START GAME"
                                                            Click="BtnStartGame_Click"
                                                            Style="{StaticResource SkinStyle_SciFiButton}"
                                                            Height="36"
                                                            Margin="0,0,6,0"
                                                            IsEnabled="False"/>
                                                    <Button x:Name="BtnLoadGame"
                                                            Grid.Column="1"
                                                            Content="LOAD SAVED GAME"
                                                            Click="BtnLoadGame_Click"
                                                            Style="{StaticResource SkinStyle_SciFiButton}"
                                                            Height="36"
                                                            MinWidth="130"
                                                            Margin="6,0,0,0"
                                                            Visibility="Collapsed"
                                                            IsEnabled="False"/>
                                                </Grid>
                                                <TextBlock x:Name="LoadGameHint"
                                                           Text=""
                                                           Foreground="#CBD5E1"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"
                                                           Visibility="Collapsed"/>

                                                <Button x:Name="BtnGameOptions"
                                                        Content="&#9881; GAME OPTIONS"
                                                        Click="BtnGameOptions_Click"
                                                        Style="{StaticResource SkinStyle_ActionMiniButton}"
                                                        Height="28"
                                                        Margin="0,0,0,8"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="180"/>
                                                <Border x:Name="GameOptionsPanel"
                                                        Background="#101822"
                                                        BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,8"
                                                        Margin="0,0,0,8"
                                                        Visibility="Collapsed">
                                                    <StackPanel x:Name="GameOptionsBody"/>
                                                </Border>

                                                <!-- Local Connection / Transport Status -->
                                                <Border Background="#101822"
                                                        BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,6"
                                                        Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="StatusText"
                                                                   Text="Disconnected from match transport."
                                                                   Foreground="#94A3B8"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="NatStatusText"
                                                                   Text=""
                                                                   Foreground="#38BDF8"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Right Column: Subspace Network, Matchmaking & Direct LAN -->
                                    <Border Grid.Column="1"
                                            Visibility="Collapsed"
                                            Background="#D00D1826"
                                            BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="6,0,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="SUBSPACE MATCH PROTOCOL"
                                                           Foreground="{StaticResource SkinBrush_CyanAccent}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock Text="Connect via central server relay or create/join dedicated match rooms."
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,10"/>

                                                <!-- Matchmaking Room & Commands -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Room" Foreground="#CBD5E1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="MmRoomBox"
                                                             Grid.Column="1"
                                                             Text="Table"
                                                             Height="28"
                                                             Padding="6,3"
                                                             Background="#141C24"
                                                             Foreground="#EEE"
                                                             BorderBrush="{StaticResource SkinBrush_InnerFrame}"/>
                                                </Grid>

                                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                                    <Button x:Name="BtnMmCreate"
                                                            Content="CREATE"
                                                            Click="BtnMmCreate_Click"
                                                            Style="{StaticResource SkinStyle_ActionMiniButton}"
                                                            Height="28"
                                                            Margin="2,0"/>
                                                    <Button x:Name="BtnMmJoin"
                                                            Content="JOIN"
                                                            Click="BtnMmJoin_Click"
                                                            Style="{StaticResource SkinStyle_ActionMiniButton}"
                                                            Height="28"
                                                            Margin="2,0"/>
                                                    <Button x:Name="BtnMmRefresh"
                                                            Content="ROOMS"
                                                            Click="BtnMmRefresh_Click"
                                                            Style="{StaticResource SkinStyle_ActionMiniButton}"
                                                            Height="28"
                                                            Margin="2,0"/>
                                                </UniformGrid>

                                                <TextBlock x:Name="MmPlayersText"
                                                           Text=""
                                                           Foreground="#CBD5E1"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <!-- Primary Action: PLAY VIA RELAY -->
                                                <Button x:Name="BtnMmRelay"
                                                        Content="PLAY VIA RELAY"
                                                        Click="BtnMmRelay_Click"
                                                        Style="{StaticResource SkinStyle_SciFiButton}"
                                                        Height="34"
                                                        Margin="0,0,0,6"/>

                                                <!-- Secondary Action: OPEN DIRECT GAME -->
                                                <Button x:Name="BtnMmPlay"
                                                        Content="OPEN DIRECT GAME"
                                                        Click="BtnMmPlay_Click"
                                                        Style="{StaticResource SkinStyle_ActionMiniButton}"
                                                        Height="28"
                                                        Margin="0,0,0,8"/>

                                                <TextBlock x:Name="MmStateText"
                                                           Text="Matchmaking connected to Lounge."
                                                           Foreground="#38BDF8"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,12"/>

                                                <!-- Collapsible Direct LAN / Localhost Expander -->
                                                <Expander x:Name="DirectConnectExpander"
                                                          Header="Direct LAN / Localhost (Advanced)"
                                                          Foreground="#8AB4F8"
                                                          FontSize="11"
                                                          IsExpanded="False"
                                                          Margin="0,0,0,4">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Port" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                            <TextBox x:Name="PortBox" Grid.Row="0" Grid.Column="1" Text="7777" Height="26" Padding="6,2" Margin="0,0,0,6"
                                                                     Background="#141C24" Foreground="#EEE" BorderBrush="{StaticResource SkinBrush_InnerFrame}"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Host IP" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Text="127.0.0.1" Height="26" Padding="6,2"
                                                                     Background="#141C24" Foreground="#EEE" BorderBrush="{StaticResource SkinBrush_InnerFrame}"/>
                                                        </Grid>

                                                        <UniformGrid Columns="2" Margin="0,0,0,6">
                                                            <Button x:Name="BtnHost" Content="HOST" Click="BtnHost_Click" Style="{StaticResource SkinStyle_ActionMiniButton}" Height="26" Margin="2"/>
                                                            <Button x:Name="BtnJoin" Content="JOIN" Click="BtnJoin_Click" Style="{StaticResource SkinStyle_ActionMiniButton}" Height="26" Margin="2"/>
                                                            <Button x:Name="BtnLocalhost" Content="LOCALHOST" Click="BtnLocalhost_Click" Style="{StaticResource SkinStyle_ActionMiniButton}" Height="26" Margin="2"/>
                                                            <Button x:Name="BtnDisconnect" Content="DISCONNECT" Click="BtnDisconnect_Click" Style="{StaticResource SkinStyle_ActionMiniButton}" Height="26" Margin="2" IsEnabled="False"/>
                                                        </UniformGrid>
                                                        <TextBlock Text="Direct IP and Localhost use TCP 7777 without relay." Foreground="#64748B" FontSize="10" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                    </Grid>
                </Border>

                <!-- 2. Bottom Social Zone: Left 2/3 crew, Right 1/3 reserve slots -->
                <Grid x:Name="BottomSocialGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,4,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/> <!-- 2/3: Avatars Dock (Lounge / Friends) -->
                        <ColumnDefinition Width="*"/>  <!-- 1/3: Reserve slots -->
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Dock (Horizontal Scroll) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SkinBrush_FooterBackground}"
                            BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Margin="0,0,4,0"
                            Padding="6,4">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="AvatarDockTitle"
                                       DockPanel.Dock="Top"
                                       Text="LOUNGE CREW"
                                       Foreground="{StaticResource SkinBrush_CyanAccent}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,4"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AvatarsContainerPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <!-- Populated dynamically in code-behind or with initial demo items -->
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,4,0"
                                Background="#16222F"
                                BorderBrush="#2A3D50"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Opacity="0.6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="[ RESERVE ]"
                                           Foreground="#64748B"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Feature Slot 1"
                                           Foreground="#475569"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="4,0,0,0"
                                Background="#16222F"
                                BorderBrush="#2A3D50"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Opacity="0.6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="[ RESERVE ]"
                                           Foreground="#64748B"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Feature Slot 2"
                                           Foreground="#475569"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
                <Grid x:Name="DeckActionHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,4,8,8" Visibility="Collapsed"/>
            </Grid>

            <!-- ===================================================================== -->
            <!-- ZONE_RIGHTRAIL (260px)                                                -->
            <!-- Matches Table Permanents Width in TableWindow                         -->
            <!-- ===================================================================== -->
            <Border Grid.Column="2"
                    Background="{StaticResource SkinBrush_RailBackground}"
                    BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                    BorderThickness="2,0,0,0"
                    Padding="10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- BACK BUTTON (Square/Compact) -->
                        <RowDefinition Height="*"/>    <!-- 3 Action / Feature Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Top Right: Square BACK Button -->
                    <Button x:Name="BtnNavBack"
                            Grid.Row="0"
                            Content="◀ BACK"
                            Click="BtnNavBack_Click"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Height="36"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <!-- Right Column 3 Vertically Distributed Slots: SHOP + 2 Placeholders -->
                    <Grid x:Name="RightFeatureGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <!-- 1. SHOP Button & Latinum Status -->
                        <Border Grid.Row="0" Margin="2,6"
                                Background="{StaticResource SkinBrush_CardTileGradient}"
                                BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="8">
                            <DockPanel x:Name="ShopDock" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                    <TextBlock Text="🪙 " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LatinumAmountText"
                                               Text="240"
                                               Foreground="{StaticResource SkinBrush_GoldAccent}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" Latinum"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnShopOpen"
                                        Content="CARD PACK SHOP"
                                        Click="BtnShopOpen_Click"
                                        Style="{StaticResource SkinStyle_SciFiButton}"
                                        Height="38"
                                        VerticalAlignment="Bottom"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{StaticResource SkinBrush_FooterBackground}"
                                BorderBrush="{StaticResource SkinBrush_OuterFrame}"
                                BorderThickness="2"
                                CornerRadius="6"
                                Margin="2,6"
                                Padding="6,4">
                        <DockPanel LastChildFill="True">
                            <!-- Chat Tabs -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="BtnChatTabLounge"
                                        Content="LOUNGE"
                                        Click="BtnChatTab_Click"
                                        Tag="Lounge"
                                        Style="{StaticResource SkinStyle_ActionMiniButton}"
                                        Width="60"/>
                                <Button x:Name="BtnChatTabPrivate"
                                        Content="PRIVATE"
                                        Click="BtnChatTab_Click"
                                        Tag="Private"
                                        Style="{StaticResource SkinStyle_ActionMiniButton}"
                                        Width="60"/>
                            </StackPanel>

                            <!-- Chat Input Box & Send Button -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button x:Name="BtnChatSend"
                                        DockPanel.Dock="Right"
                                        Content="SEND"
                                        Click="BtnChatSend_Click"
                                        Style="{StaticResource SkinStyle_ActionMiniButton}"
                                        Width="48"
                                        Margin="4,0,0,0"/>
                                <TextBox x:Name="ChatInputBox"
                                         Height="20"
                                         Padding="4,1"
                                         FontSize="11"
                                         Background="#141C24"
                                         Foreground="#EEE"
                                         BorderBrush="{StaticResource SkinBrush_InnerFrame}"
                                         KeyDown="ChatInputBox_KeyDown"/>
                            </DockPanel>

                            <!-- Chat History View -->
                            <ScrollViewer x:Name="ChatScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBox x:Name="ChatHistoryBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="Transparent"
                                         Foreground="#CBD5E1"
                                         BorderThickness="0"
                                         FontSize="11"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    </Grid>
                    <Grid x:Name="DeckDetailHost" Grid.Row="1" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Grid x:Name="DeckZoomHost" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="40"/>
        </Grid>
    </DockPanel>
</Window>
