<Window x:Class="StarTrekCCG.AccountGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#252528"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LobbyChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,20" Background="#252528">
        <StackPanel>
            <TextBlock Text="Sign in" Foreground="#EEE" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Account uses the server deck list. Sandbox keeps local decks. Direct IP and Localhost stay in the lobby."
                       Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Server" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox x:Name="ServiceBox" Grid.Row="0" Grid.Column="1" IsEditable="True"
                          Text="127.0.0.1:7788" Height="28" Margin="0,0,0,8">
                    <ComboBoxItem Content="127.0.0.1:7788"/>
                    <ComboBoxItem Content="192.168.50.241:7788"/>
                    <ComboBoxItem Content="81.217.114.46:7788"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Name" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" MaxLength="24"
                         Height="28" Padding="6,3" Margin="0,0,0,8"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
                <TextBlock Grid.Row="2" Text="Password" Foreground="#AAA" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1"
                             Height="28" Padding="6,3"
                             Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
            </Grid>
            <TextBlock Text="Server address: a domain or an IP, with the port. Same PC: 127.0.0.1:7788. Another PC: the host machine's LAN address and port 7788. A public game: a public host and port 7788. No domain name is set up here."
                       Foreground="#AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Display name is max 24 characters and is bound to the account."
                       Foreground="#888" FontSize="11" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Register" Click="Register_Click" Height="32" MinWidth="88" Margin="0,0,8,0"
                        Background="#0E639C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Login" Click="Login_Click" Height="32" MinWidth="88" Margin="0,0,8,0"
                        Background="#0E639C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Continue as Sandbox" Click="Sandbox_Click" Height="32" MinWidth="150"
                        Background="#3A3A48" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="" Foreground="#8AB4F8" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
