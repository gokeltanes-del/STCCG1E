<Window x:Class="StarTrekCCG.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Table"
        Height="900" Width="1680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SkinBrush_WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="TableWindow_HookDetailGroups">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#2A4A66"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A4A66"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E2A38"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E0F2FE"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#1E2A38"/>
            <Style x:Key="SkinStyle_ModeRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#E0F2FE"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{StaticResource SkinBrush_CyanAccent}" BorderThickness="1.5"
                                        Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse x:Name="Dot" Width="8" Height="8"
                                             Fill="{StaticResource SkinBrush_GoldAccent}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SkinBrush_GoldAccent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SkinStyle_OverlayListItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="2,1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E3348"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A4A66"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource SkinBrush_HeaderBackground}" Foreground="{StaticResource SkinBrush_CyanAccent}">
            <Menu.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#2A4A66"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A4A66"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E2A38"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E0F2FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#1E2A38"/>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E0F2FE"/>
                    <Setter Property="Background" Value="{StaticResource SkinBrush_HeaderBackground}"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_New game…" Click="MenuNewGame_Click"/>
                <MenuItem Header="_Quick game…" Click="MenuQuickGame_Click"/>
                <MenuItem Header="_Save game…" Click="MenuSaveGame_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Load game…" Click="MenuLoadGame_Click" InputGestureText="Ctrl+L"/>
                <Separator/>
                <MenuItem Header="_Open deck…" Click="MenuLoadDeck_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Deck Builder…" Click="MenuDeckBuilder_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Reset zoom" Click="MenuZoomReset_Click"/>
                <MenuItem Header="_Center spaceline" Click="MenuCenterSpaceline_Click"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Player aids">
                    <MenuItem x:Name="AidLegalResponsesItem" Header="Highlight legal responses"
                              IsCheckable="True" IsChecked="True" Click="AidLegalResponses_Click"/>
                    <MenuItem x:Name="AidZoneCountsItem" Header="Zone / pile counts"
                              IsCheckable="True" IsChecked="True" Click="AidZoneCounts_Click"/>
                    <MenuItem x:Name="AidSortHandItem" Header="Sort hand by type"
                              IsCheckable="True" IsChecked="True" Click="AidSortHand_Click"/>
                </MenuItem>
                <MenuItem Header="_Response window">
                    <MenuItem Header="Default duration">
                        <MenuItem x:Name="OptResponse2s" Header="2 seconds (Fast)" IsCheckable="True" Click="OptResponseDuration_Click" Tag="2"/>
                        <MenuItem x:Name="OptResponse3s" Header="3 seconds (Standard)" IsCheckable="True" IsChecked="True" Click="OptResponseDuration_Click" Tag="3"/>
                        <MenuItem x:Name="OptResponse5s" Header="5 seconds (Slow)" IsCheckable="True" Click="OptResponseDuration_Click" Tag="5"/>
                    </MenuItem>
                    <MenuItem Header="Think duration">
                        <MenuItem x:Name="OptThink10s" Header="10 seconds" IsCheckable="True" IsChecked="True" Click="OptThinkDuration_Click" Tag="10"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="OptPresetHotseat" Header="Preset: Hotseat standard (3s / 10s)" Click="OptPresetHotseat_Click"/>
                    <MenuItem x:Name="OptPresetFast" Header="Preset: Test fast (2s / 10s)" Click="OptPresetFast_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Developer">
                <MenuItem x:Name="DevRevealSeedItem" Header="Reveal seed under missions" IsCheckable="True" Click="DevRevealSeed_Click"/>
                <MenuItem x:Name="DevShowSeedCountItem" Header="Show seed counts" IsCheckable="True" Click="DevShowSeedCount_Click"/>
                <MenuItem x:Name="DevPeekOpponentItem" Header="Peek opponent piles" IsCheckable="True" Click="DevPeekOpponent_Click"/>
                <MenuItem x:Name="DevShowDebugLogItem" Header="Show Debug: lines in Action History" IsCheckable="True" IsChecked="True" Click="DevShowDebugLog_Click"/>
                <MenuItem x:Name="DevFileLogItem" Header="Write debug file (Data/Logs)" IsCheckable="True" IsChecked="True" Click="DevFileLog_Click"/>
                <MenuItem Header="Open debug log file…" Click="DevOpenLogFile_Click"/>
                <MenuItem Header="Open Logs folder…" Click="DevOpenLogFolder_Click"/>
                <MenuItem x:Name="DevPlaySeedFromHandItem" Header="Play seed cards from hand" IsCheckable="True" Click="DevPlaySeedFromHand_Click"/>
                <MenuItem x:Name="DevLongGameItem" Header="Long game (500 points to win)" IsCheckable="True" Click="DevLongGame_Click"/>
                <Separator/>
                <MenuItem Header="Inspect opponent hand (gallery)…" Click="DevInspectOppHand_Click"/>
                <MenuItem Header="Inspect opponent discard (gallery)…" Click="DevInspectOppDiscard_Click"/>
                <MenuItem Header="Inspect opponent draw (backs)…" Click="DevInspectOppDraw_Click"/>
                <Separator/>
                <MenuItem Header="Dump legal moves" Click="DevDumpLegalMoves_Click"/>
                <MenuItem Header="Dump Board" Click="DevDumpBoard_Click"/>
                <MenuItem Header="Download from Q's Tent…" Click="DevTentDownload_Click"/>
                <MenuItem Header="Flip own Hidden Agendas…" Click="DevFlipHiddenAgendas_Click"/>
                <MenuItem Header="Add card to game…" Click="DevAddCard_Click"/>
                <MenuItem Header="Deck Builder…" Click="MenuDeckBuilder_Click"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="{StaticResource SkinBrush_HeaderBarGradient}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="0,0,0,2" Padding="10,4" MinHeight="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTableCommand" Content="COMMAND" Click="BtnTableCommand_Click"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScoreText" Text="P1: 0  ·  P2: 0" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="ActivePlayerBanner" Background="{StaticResource SkinBrush_CenterBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1" CornerRadius="4" Padding="14,4" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonDown="ActivePlayerBanner_MouseLeftButtonDown">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="ResponseIndicatorBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="#7B1FA2" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" Cursor="Hand" MouseLeftButtonDown="ResponseIndicator_MouseLeftButtonDown" MouseRightButtonDown="ResponseIndicator_MouseRightButtonDown" MouseRightButtonUp="ResponseIndicator_MouseRightButtonUp" ToolTip="Click = Think mode  ·  RMB = Enlarge trigger card">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ResponseIndicatorText" Text="⚡ Response available (P2)" Foreground="#FFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ResponseCountdownText" Text=" · 3s" Foreground="#FFE082" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <TextBlock Text=" · [R] Details  [Space] Pass" Foreground="#E1BEE7" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ActivePlayerText" Text="–" Foreground="#FFE082" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <TextBlock x:Name="PhaseHint" Visibility="Collapsed"/>
                <TextBlock x:Name="PhaseLabel" Visibility="Collapsed"/>
                <Border x:Name="ResponsePanel" Visibility="Collapsed" Width="0" Height="0">
                    <StackPanel>
                        <TextBlock x:Name="ResponseTitle" Text=""/>
                        <TextBlock x:Name="ResponseStackText" Text=""/>
                        <Button x:Name="BtnResponsePass" Content="Pass" Click="BtnResponsePass_Click"/>
                        <TextBlock x:Name="ResponseHint" Text=""/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMpSave" Content="Save game" Click="BtnMpSave_Click" Visibility="Collapsed"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnNetLink" Content="Connected" Click="Reconnect_Click" Visibility="Collapsed"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Grid MinWidth="200" Height="30" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="BtnPhaseNext" Content="Next phase ▶" Click="BtnPhaseNext_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4" IsEnabled="False"/>
                    <Button x:Name="BtnSeedFinish" Content="Finish seed" Click="BtnSeedFinish_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4" IsEnabled="False" Visibility="Collapsed"/>
                    <Button x:Name="BtnEndTurn" Content="End PLAY phase (Space)" Click="BtnEndTurn_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
                <Button Grid.Column="3" Content="Action History" Click="BtnHistoryOpen_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="12,5" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SkinBrush_RailBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="0,0,1,1" Padding="3,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="OpponentZonesPanel" Width="150"/>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource SkinBrush_RailBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="0,1,1,0" Padding="3,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PlayerZonesPanel" Width="150"/>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="OppHandStripBorder" Background="#1B3038" BorderBrush="#2A4A55" BorderThickness="0,0,0,1" Padding="2,1" MinHeight="102" Height="102">
                        <DockPanel LastChildFill="True">
                            <!-- Pepsch mockup: Hand-Label vertikal links (Oben→Unten) -->
                            <Border DockPanel.Dock="Left" Width="18" Margin="0,0,2,0" VerticalAlignment="Stretch" ClipToBounds="True">
                                <TextBlock x:Name="OppStripTitle" Text="P2 HAND" FontSize="10" FontWeight="SemiBold" Foreground="#8EC8D8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="OppStripPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border x:Name="BoardFrameBorder" Grid.Row="1" Background="#0A0A12" Margin="2" CornerRadius="3" BorderBrush="#4A8A60" BorderThickness="3" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="BoardBackdrop" Stretch="UniformToFill" StretchDirection="Both" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                            <Border x:Name="BoardTintOverlay" Background="#121E18" Opacity="0.22" IsHitTestVisible="False"/>
                            <Border x:Name="BoardPlayHalo" Visibility="Collapsed" BorderBrush="#70E8FF" BorderThickness="5" CornerRadius="3" Background="#2800C0E8" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" CanContentScroll="False" PanningMode="Both">
                                <Canvas x:Name="TableCanvas" Width="2800" Height="1400" Background="Transparent" MouseLeftButtonDown="TableCanvas_MouseLeftButtonDown" MouseWheel="TableCanvas_MouseWheel" MouseRightButtonDown="TableCanvas_MouseRightButtonDown" MouseRightButtonUp="TableCanvas_MouseRightButtonUp" MouseMove="TableCanvas_MouseMove">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                    </Canvas.LayoutTransform>
                                </Canvas>
                            </ScrollViewer>
                            <!-- Think Tray: Übersicht legaler Responses über der Hand -->
                            <!-- Pepsch: dynamic width (cards + left rail), centered over responder hand -->
                            <Border x:Name="ThinkTrayBorder" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="8,4" Background="#EE16202C" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="2" CornerRadius="5" Padding="3,4" Panel.ZIndex="220" MaxHeight="140">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Left rail: title / countdown / hints / Pass (no top banner duplicate) -->
                                    <Border x:Name="ThinkTrayRail" Width="96" Margin="0,0,2,0" Padding="4,4" Background="{StaticResource SkinBrush_HeaderBackground}" CornerRadius="4" VerticalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ThinkTrayTitle" Text="LEGAL RESPONSES (P2)" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ThinkTrayCountdown" Text="3s" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock Text="Click play&#10;RMB large&#10;Space = Pass" Foreground="#AAA" FontSize="9" LineHeight="12" Margin="0,6,0,0"/>
                                            <Button x:Name="BtnThinkPass" Content="Pass" Click="BtnThinkPass_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="4,2" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                        <StackPanel x:Name="ThinkTrayPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardRevealOverlay" Visibility="Collapsed" Background="#E60B1017" Panel.ZIndex="200">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="12" MaxWidth="720" MaxHeight="520">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="RevealCasualtyLabel" Text="Personnel died" Visibility="Collapsed" Foreground="#FF3B30" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Border x:Name="RevealFaceFrame" Width="220" Height="308" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1" CornerRadius="4" Background="{StaticResource SkinBrush_CenterBackground}" Cursor="Hand" ToolTip="Hold RMB = Large view" MouseRightButtonDown="RevealImage_MouseRightButtonDown" MouseRightButtonUp="RevealImage_MouseRightButtonUp">
                                                    <Image x:Name="RevealImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseRightButtonDown="RevealImage_MouseRightButtonDown" MouseRightButtonUp="RevealImage_MouseRightButtonUp"/>
                                                </Border>
                                                <ScrollViewer x:Name="RevealFacesScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="308">
                                                    <StackPanel x:Name="RevealFacesPanel" Orientation="Horizontal"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </StackPanel>
                                        <DockPanel Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealTitle" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealSubtitle" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealAudience" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealTimerText" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button x:Name="BtnRevealRespond" Content="Respond" Style="{StaticResource SkinStyle_SciFiButton}" Padding="16,8" Margin="0,0,8,0" Click="BtnRevealRespond_Click" Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealPass" Content="Pass" Style="{StaticResource SkinStyle_SciFiButton}" Padding="16,8" Margin="0,0,8,0" Click="BtnRevealPass_Click" Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealYes" Content="Yes" Style="{StaticResource SkinStyle_SciFiButton}" Padding="16,8" Margin="0,0,8,0" Click="BtnRevealYes_Click" Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealNo" Content="No" Style="{StaticResource SkinStyle_SciFiButton}" Padding="16,8" Margin="0,0,8,0" Click="BtnRevealNo_Click" Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealOk" Content="OK" Style="{StaticResource SkinStyle_SciFiButton}" Padding="20,8" Click="BtnRevealOk_Click"/>
                                            </WrapPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                                <TextBlock x:Name="RevealBody" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border x:Name="CardDetailOverlay" Visibility="Collapsed" Background="#E60B1017" Panel.ZIndex="205" MouseLeftButtonDown="CardDetailOverlay_MouseLeftButtonDown">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="12" MaxWidth="960" MaxHeight="760" MouseLeftButtonDown="CardDetailPanel_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="220"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Column="0" Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="200" Margin="0,0,16,0" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="1" CornerRadius="4" Background="{StaticResource SkinBrush_CenterBackground}" VerticalAlignment="Top" Cursor="Hand">
                                                <Image x:Name="DetailImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="DetailImage_MouseLeftButtonDown" MouseRightButtonDown="DetailImage_MouseRightButtonDown" MouseRightButtonUp="DetailImage_MouseRightButtonUp"/>
                                            </Border>
                                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock x:Name="DetailName" Text="–" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SkinBrush_GoldAccent}" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DetailType" Foreground="#4EC9B0" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DetailAttributes" Foreground="#B5CEA8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                    <StackPanel x:Name="DetailStatusBlock" Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="DetailClass" Foreground="#DCDCAA" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                                    <WrapPanel x:Name="DetailStaffRow" Margin="0,2,0,2"/>
                                                    <WrapPanel x:Name="DetailIconRow" Margin="0,2,0,6"/>
                                                    <TextBlock x:Name="DetailStaff" Foreground="#9CDCFE" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DetailIcons" Foreground="#C586C0" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DetailText" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" Margin="12,0,0,0" Width="132">
                                            <Button x:Name="BtnDetailBack" Content="◀ Back" Style="{StaticResource SkinStyle_SciFiButton}" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed" Click="BtnDetailBack_Click"/>
                                            <Button x:Name="BtnDetailBeamSelect" Content="Select none" Style="{StaticResource SkinStyle_SciFiButton}" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed" Click="BtnDetailBeamSelect_Click"/>
                                            <Button x:Name="BtnCardDetailClose" Content="Close" Style="{StaticResource SkinStyle_SciFiButton}" Padding="8,6" Click="BtnCardDetailClose_Click"/>
                                        </StackPanel>
                                        <Border x:Name="DetailStackSection" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" x:Name="DetailStackTitle" Text="Contents" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <ScrollViewer x:Name="DetailStackScroll" DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="220" MinHeight="110">
                                                    <WrapPanel x:Name="DetailStackCards"/>
                                                </ScrollViewer>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="140" Margin="0,0,0,8">
                                                    <TextBlock x:Name="DetailStackStats" Foreground="#B5CEA8" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border x:Name="HistoryOverlay" Visibility="Collapsed" Background="#E60B1017" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="12" MaxWidth="880" MinHeight="480" MaxHeight="960">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Copy" Click="BtnHistoryCopy_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4" Margin="6,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Content="Open log" Click="DevOpenLogFile_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4" Margin="6,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Content="Close" Click="BtnHistoryClose_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4"/>
                                            <TextBlock Text="Action History" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <!-- Third pane: last played cards (Face). Network: same row via PlayReveal Host broadcast. -->
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Top" Text="Recently played (click = detail / text)" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="118">
                                                <StackPanel x:Name="PlayHistoryStrip" Orientation="Horizontal"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Top" Text="Legal moves (engine)" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ListBox x:Name="LegalMovesList" Height="140" Background="{StaticResource SkinBrush_CenterBackground}" BorderThickness="0" Foreground="#E2E8F0" FontSize="12" FontFamily="Consolas" ItemContainerStyle="{StaticResource SkinStyle_OverlayListItem}"/>
                                        </DockPanel>
                                        <ListBox x:Name="ActionHistoryList" MinHeight="280" Background="{StaticResource SkinBrush_CenterBackground}" BorderThickness="0" Foreground="#E2E8F0" FontSize="12" FontFamily="Consolas" SelectionMode="Extended" ItemContainerStyle="{StaticResource SkinStyle_OverlayListItem}"/>
                                    </DockPanel>
                                </Border>
                            </Border>
                            <Border x:Name="TeamOverlay" Visibility="Collapsed" Background="#E60B1017" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="12" MaxWidth="560" MaxHeight="520">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Close" Click="BtnTeamClose_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="10,4"/>
                                            <TextBlock x:Name="TeamOverlayTitle" Text="Crew / Away Team" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="16" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TeamOverlayBody" Foreground="#E2E8F0" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Border>
                            <Border x:Name="KidnapOverlay" Visibility="Collapsed" Background="#E60B1017" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="12" MaxWidth="920" MaxHeight="680">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" x:Name="KidnapTitle" Text="Telepathic Alien Kidnappers" Foreground="{StaticResource SkinBrush_GoldAccent}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock DockPanel.Dock="Top" x:Name="KidnapHint" Text="Name a card type, then pick a facedown card." Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel DockPanel.Dock="Top" x:Name="KidnapTypePanel" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnKidnapCancel" DockPanel.Dock="Bottom" Content="Cancel" Click="BtnKidnapCancel_Click" Style="{StaticResource SkinStyle_SciFiButton}" Padding="12,6" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <WrapPanel x:Name="KidnapCardsPanel"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" x:Name="PlayerHandStripBorder" Background="#2A3A32" BorderBrush="#3A5A48" BorderThickness="0,1,0,0" Padding="2,1" MinHeight="102" Height="102">
                        <DockPanel LastChildFill="True">
                            <!-- Pepsch mockup: Hand-Label vertikal links (Oben→Unten) -->
                            <Border DockPanel.Dock="Left" Width="18" Margin="0,0,2,0" VerticalAlignment="Stretch" ClipToBounds="True">
                                <TextBlock x:Name="PlayerStripTitle" Text="P1 HAND" FontSize="10" FontWeight="SemiBold" Foreground="#B5CEA8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PlayerStripPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="1" x:Name="StackPanelBorder" Background="{StaticResource SkinBrush_RailBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" x:Name="OppTischZoneBorder" Background="{StaticResource SkinBrush_RailBackground}" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="0,0,0,1" Padding="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="TopTableLabel" Text="P2 TABLE" FontSize="11" FontWeight="SemiBold" Foreground="#8EC8D8" Margin="2,2,2,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="OppTablePermanentsPanel" Width="248" VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" x:Name="TischZoneBorder" Background="{StaticResource SkinBrush_RailBackground}" BorderBrush="{StaticResource SkinBrush_InnerFrame}" BorderThickness="0,1,0,0" Padding="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="BottomTableLabel" Text="P1 TABLE" FontSize="11" FontWeight="SemiBold" Foreground="#B5CEA8" Margin="2,2,2,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="TablePermanentsPanel" Width="248" VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel x:Name="StackGrid" Visibility="Collapsed" Width="0" Height="0"/>
                <TextBlock x:Name="StackTitle" Visibility="Collapsed"/>
            </Grid>
            <!-- Play fly-in: transparent Canvas (no dim / no banner). Card flies Hand→Center→Slot. -->
            <Canvas x:Name="PlayFlyInOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Background="Transparent" Panel.ZIndex="190">
                <Border x:Name="PlayFlyInCard" Width="100" Height="140" Background="#111" BorderBrush="#666" BorderThickness="1" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.75" Color="#000000"/>
                    </Border.Effect>
                    <Image x:Name="PlayFlyInImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Canvas>
            <Canvas x:Name="DragLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="50"/>
            <Border x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Background="#CC101014" Panel.ZIndex="100">
                <Border Background="{StaticResource SkinBrush_HeaderBackground}" CornerRadius="10" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="Star Trek CCG 1E" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sandbox Table" FontSize="13" Foreground="#888" HorizontalAlignment="Center" Margin="0,4,0,22"/>
                        <Button Content="New game" Click="WelcomeNewGame_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="40" Margin="0,0,0,10"/>
                        <Button Content="Load game…" Click="MenuLoadGame_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="36" Margin="0,0,0,6"/>
                        <Button Content="Quick game…" Click="MenuQuickGame_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="36" Margin="0,0,0,6"/>
                        <StackPanel x:Name="NewGameOptions" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Game mode" Foreground="#AAA" FontSize="12" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <RadioButton x:Name="ModeHotseat" Content="Hotseat" IsChecked="True" Style="{StaticResource SkinStyle_ModeRadio}" Margin="0,0,14,0" GroupName="GameMode"/>
                                <RadioButton x:Name="ModeNetwork" Content="Network" IsEnabled="True" Style="{StaticResource SkinStyle_ModeRadio}" Margin="0,0,14,0" GroupName="GameMode" Checked="ModeNetwork_Checked"/>
                                <RadioButton x:Name="ModeSingle" Content="Singleplayer (AI)" IsEnabled="False" Style="{StaticResource SkinStyle_ModeRadio}" GroupName="GameMode"/>
                            </StackPanel>
                            <Button Content="Open lobby…" Click="OpenLobby_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="32" Margin="0,0,0,10"/>
                            <Button Content="Reconnect" Click="Reconnect_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="32" Margin="0,0,0,10"/>
                            <Button Content="Load deck…" Click="MenuLoadDeck_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="36" Margin="0,0,0,8"/>
                            <Button Content="Create deck (Builder)…" Click="WelcomeDeckBuilder_Click" Style="{StaticResource SkinStyle_SciFiButton}" Height="36"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
            <Border x:Name="ZoomOverlay" Grid.ColumnSpan="2" Background="#E60B1017" Visibility="Collapsed" Panel.ZIndex="300" MouseLeftButtonDown="ZoomOverlay_MouseLeftButtonDown" MouseRightButtonUp="ZoomOverlay_MouseRightButtonUp">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SkinBrush_HeaderBackground}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="8" Padding="12" MaxWidth="720" MaxHeight="920" MouseLeftButtonDown="ZoomCard_MouseLeftButtonDown">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="ZoomCaption" Text="Click = close" Foreground="{StaticResource SkinBrush_CyanAccent}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Image x:Name="ZoomImage" Stretch="Uniform" MaxWidth="680" MaxHeight="860" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"/>
                    </DockPanel>
                </Border>
            </Border>
            <Border x:Name="NetReconnectShield" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="270" Background="#E60B1017"/>
            <Border x:Name="NetReconnectBanner" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="280"
                    Background="{StaticResource SkinBrush_HeaderBarGradient}" BorderBrush="{StaticResource SkinBrush_OuterFrame}" BorderThickness="1.5" CornerRadius="6"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12,8,12,0" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnNetReconnectNow" DockPanel.Dock="Right" Content="Try now" Click="Reconnect_Click"
                            Style="{StaticResource SkinStyle_SciFiButton}"
                            Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NetReconnectBannerText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Connection lost. Reconnecting. 120s left of 120."/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
