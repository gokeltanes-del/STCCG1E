<Window x:Class="StarTrekCCG.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star Trek CCG 1E – Table"
        Height="900" Width="1680"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        PreviewKeyDown="Window_PreviewKeyDown">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#2D2D30" Foreground="White">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Padding" Value="10,4"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_New game…" Click="MenuNewGame_Click"/>
                <MenuItem Header="_Quick game…" Click="MenuQuickGame_Click"/>
                <MenuItem Header="_Save game…" Click="MenuSaveGame_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Load game…" Click="MenuLoadGame_Click" InputGestureText="Ctrl+L"/>
                <Separator/>
                <MenuItem Header="_Open deck…" Click="MenuLoadDeck_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Deck Builder…" Click="MenuDeckBuilder_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Reset zoom" Click="MenuZoomReset_Click"/>
                <MenuItem Header="_Center spaceline" Click="MenuCenterSpaceline_Click"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Player aids">
                    <MenuItem x:Name="AidLegalResponsesItem" Header="Highlight legal responses"
                              IsCheckable="True" IsChecked="True" Click="AidLegalResponses_Click"
                              ToolTip="Mark cards in hand that can respond to the current stack action"/>
                    <MenuItem x:Name="AidOwnSeedCountItem" Header="Own seed counts under missions"
                              IsCheckable="True" IsChecked="True" Click="AidOwnSeedCount_Click"
                              ToolTip="Show how many of your seed cards are under each mission"/>
                    <MenuItem x:Name="AidZoneCountsItem" Header="Zone / pile counts"
                              IsCheckable="True" IsChecked="True" Click="AidZoneCounts_Click"
                              ToolTip="Show number of cards in your zone piles"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Developer">
                <MenuItem x:Name="DevRevealSeedItem" Header="Reveal seed under missions"
                          IsCheckable="True" Click="DevRevealSeed_Click"
                          ToolTip="Show facedown dilemma/artifact names and images"/>
                <MenuItem x:Name="DevShowSeedCountItem" Header="Show seed counts"
                          IsCheckable="True" Click="DevShowSeedCount_Click"
                          ToolTip="Show how many cards are under each mission"/>
                <MenuItem x:Name="DevPeekOpponentItem" Header="Peek opponent piles"
                          IsCheckable="True" Click="DevPeekOpponent_Click"
                          ToolTip="Show opponent hand/draw/seed/side contents (normally private)"/>
                <MenuItem x:Name="DevShowDebugLogItem" Header="Show Debug: lines in Action History"
                          IsCheckable="True" IsChecked="True" Click="DevShowDebugLog_Click"
                          ToolTip="Include Debug: entries in Action History (for development)"/>
                <Separator/>
                <MenuItem Header="Add card to game…" Click="DevAddCard_Click"
                          ToolTip="Search the database and inject a card into the active player's pile"/>
                <MenuItem Header="Deck Builder…" Click="MenuDeckBuilder_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top control bar (was left sidebar + bottom status) -->
        <Border DockPanel.Dock="Top" Background="#1E1E24" BorderBrush="#333" BorderThickness="0,0,0,1"
                Padding="8,2" Height="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status messages -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#E0E0E0"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="PhaseHint" Text="" Foreground="#9CDCFE"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: score · turn · phase button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ScoreText" Text="P1: 0  ·  P2: 0" Foreground="#B5CEA8"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border x:Name="ActivePlayerBanner" Background="#2A3A4A" CornerRadius="3"
                            Padding="12,2" Margin="0,0,8,0" MinWidth="220">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ActivePlayerText" Text="–" Foreground="#FFE082"
                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="NoWrap"/>
                            <TextBlock x:Name="PhaseLabel" Text="" Foreground="#AAA"
                                       FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <Grid Width="140" Height="24">
                        <Button x:Name="BtnPhaseNext" Content="Next phase ▶"
                                Click="BtnPhaseNext_Click" Padding="8,4"
                                Background="#3A3A48" Foreground="White" BorderBrush="#555"
                                Cursor="Hand" IsEnabled="False"/>
                        <Button x:Name="BtnSeedFinish" Content="Finish seed"
                                Click="BtnSeedFinish_Click" Padding="8,4"
                                Background="#2A4A3A" Foreground="White" BorderBrush="#3A6A4A"
                                Cursor="Hand" IsEnabled="False" Visibility="Collapsed"
                                ToolTip="End seed phase and draw opening hands"/>
                        <Button x:Name="BtnEndTurn" Content="End turn ▶"
                                Click="BtnEndTurn_Click" Padding="8,4"
                                Background="#4A3A2A" Foreground="White" BorderBrush="#6A5A3A"
                                Cursor="Hand" Visibility="Collapsed"/>
                    </Grid>
                    <Border x:Name="ResponsePanel" Visibility="Collapsed" Width="0" Height="0">
                        <StackPanel>
                            <TextBlock x:Name="ResponseTitle" Text=""/>
                            <TextBlock x:Name="ResponseStackText" Text=""/>
                            <Button x:Name="BtnResponsePass" Content="Pass" Click="BtnResponsePass_Click"/>
                            <TextBlock x:Name="ResponseHint" Text=""/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: action history -->
                <Button Grid.Column="2" Content="Action History" Click="BtnHistoryOpen_Click"
                        Padding="12,4" Margin="16,0,0,0" FontSize="12"
                        Background="#333" Foreground="#CCC" BorderBrush="#555" Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Space = next phase / end turn"/>
            </Grid>
        </Border>

        <!-- Left piles (tall) | center board+thin TABLE | right detail -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: P2 piles (dark) | P1 piles (light) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#252528" BorderBrush="#1A1A1C" BorderThickness="0,0,1,1"
                        Padding="3,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="OpponentZonesPanel" Width="150"/>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Background="#3E3E46" BorderBrush="#2E2E34" BorderThickness="0,1,1,0"
                        Padding="3,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PlayerZonesPanel" Width="150"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- CENTER: board+hands | full-height TABLE column -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="OppHandStripBorder" Background="#1B3038"
                        BorderBrush="#2A4A55" BorderThickness="0,0,0,1" Padding="4,2" MinHeight="118" Height="118">
                        <DockPanel>
                            <TextBlock x:Name="OppStripTitle" DockPanel.Dock="Top"
                                   Text="P2 HAND" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#8EC8D8" Margin="2,0,2,2"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="OppStripPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#121212" Margin="2" CornerRadius="2" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Mouse wheel = zoom  •  RMB = pan  •  Doorway on side deck = unlock"
                                   Foreground="#444" FontSize="11" Margin="10,4,0,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="TableScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      CanContentScroll="False">
                                <Canvas x:Name="TableCanvas"
                                    Width="2800" Height="1400"
                                    Background="#1A1A1A"
                                    MouseLeftButtonDown="TableCanvas_MouseLeftButtonDown"
                                    MouseWheel="TableCanvas_MouseWheel"
                                    MouseRightButtonDown="TableCanvas_MouseRightButtonDown"
                                    MouseRightButtonUp="TableCanvas_MouseRightButtonUp"
                                    MouseMove="TableCanvas_MouseMove">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                    </Canvas.LayoutTransform>
                                </Canvas>
                            </ScrollViewer>
                            <Border x:Name="CardRevealOverlay" Visibility="Collapsed"
                                Background="#CC0A0A0F" Panel.ZIndex="200">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#252530" BorderBrush="#6A6A80" BorderThickness="1"
                                    CornerRadius="10" Padding="16" MaxWidth="720" MaxHeight="520">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="220" Height="308" Margin="0,0,16,0"
                                            BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                                            Background="#111">
                                            <Image x:Name="RevealImage" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <DockPanel Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealTitle"
                                                   Foreground="#FFE082" FontSize="14" FontWeight="Bold"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealSubtitle"
                                                   Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealAudience"
                                                   Foreground="#FFE082" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="RevealTimerText"
                                                   Foreground="#FFB74D" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button x:Name="BtnRevealRespond" Content="Respond" Padding="16,8"
                                                    Margin="0,0,8,0" Click="BtnRevealRespond_Click"
                                                    Background="#4A2A6A" Foreground="White"
                                                    BorderBrush="#7A4A9A" Cursor="Hand"
                                                    Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealPass" Content="Pass" Padding="16,8"
                                                    Margin="0,0,8,0" Click="BtnRevealPass_Click"
                                                    Background="#3A3A58" Foreground="White"
                                                    BorderBrush="#5A5A78" Cursor="Hand"
                                                    Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealYes" Content="Yes" Padding="16,8"
                                                    Margin="0,0,8,0" Click="BtnRevealYes_Click"
                                                    Background="#2A5A3A" Foreground="White"
                                                    BorderBrush="#3A7A4A" Cursor="Hand"
                                                    Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealNo" Content="No" Padding="16,8"
                                                    Margin="0,0,8,0" Click="BtnRevealNo_Click"
                                                    Background="#5A2A2A" Foreground="White"
                                                    BorderBrush="#7A3A3A" Cursor="Hand"
                                                    Visibility="Collapsed"/>
                                                <Button x:Name="BtnRevealOk" Content="OK" Padding="20,8"
                                                    Click="BtnRevealOk_Click"
                                                    Background="#3A3A58" Foreground="White"
                                                    BorderBrush="#5A5A78" Cursor="Hand"/>
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      MaxHeight="320">
                                                <TextBlock x:Name="RevealBody" Foreground="#D4D4D4"
                                                       FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border x:Name="CardDetailOverlay" Visibility="Collapsed"
                                Background="#CC0A0A0F" Panel.ZIndex="205"
                                MouseLeftButtonDown="CardDetailOverlay_MouseLeftButtonDown">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#252530" BorderBrush="#6A6A80" BorderThickness="1"
                                    CornerRadius="10" Padding="16" MaxWidth="640" MaxHeight="560"
                                    MouseLeftButtonDown="CardDetailPanel_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="200" Margin="0,0,16,0"
                                            BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                                            Background="#111"
                                            Cursor="Hand" ToolTip="Hold right mouse button to enlarge">
                                            <Image x:Name="DetailImage" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               MouseLeftButtonDown="DetailImage_MouseLeftButtonDown"
                                               MouseRightButtonDown="DetailImage_MouseRightButtonDown"
                                               MouseRightButtonUp="DetailImage_MouseRightButtonUp"/>
                                        </Border>
                                        <DockPanel Grid.Column="1">
                                            <Button DockPanel.Dock="Bottom" Content="Close" Padding="16,6"
                                                HorizontalAlignment="Right" Margin="0,12,0,0"
                                                Click="BtnCardDetailClose_Click"
                                                Background="#3A3A58" Foreground="White" BorderBrush="#5A5A78"
                                                Cursor="Hand"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailName" Text="–"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                                   TextWrapping="Wrap"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailType"
                                                   Foreground="#4EC9B0" FontSize="12" Margin="0,4,0,8"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailAttributes"
                                                   Foreground="#B5CEA8" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailClass"
                                                   Foreground="#DCDCAA" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailStaff"
                                                   Foreground="#9CDCFE" FontSize="11" Margin="0,0,0,2"/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="DetailIcons"
                                                   Foreground="#C586C0" FontSize="11" Margin="0,0,0,8"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="DetailText" Foreground="#D4D4D4" FontSize="12"
                                                       TextWrapping="Wrap" LineHeight="18"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border x:Name="HistoryOverlay" Visibility="Collapsed"
                                Background="#CC0A0A0F" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#252530" BorderBrush="#6A6A80" BorderThickness="1"
                                    CornerRadius="10" Padding="16" Width="640" MaxHeight="560">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Copy" Click="BtnHistoryCopy_Click"
                                                Padding="10,4" Margin="6,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Content="Close" Click="BtnHistoryClose_Click"
                                                Padding="10,4"/>
                                            <TextBlock Text="Action History" Foreground="#FFE082"
                                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ListBox x:Name="ActionHistoryList"
                                             Background="#1A1A22" BorderThickness="0"
                                             Foreground="#B5CEA8" FontSize="12"
                                             FontFamily="Consolas"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </DockPanel>
                                </Border>
                            </Border>
                            <Border x:Name="TeamOverlay" Visibility="Collapsed"
                                Background="#CC0A0A0F" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#252530" BorderBrush="#6A6A80" BorderThickness="1"
                                    CornerRadius="10" Padding="16" Width="560" MaxHeight="520">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Close" Click="BtnTeamClose_Click"
                                                Padding="10,4"/>
                                            <TextBlock x:Name="TeamOverlayTitle" Text="Crew / Away Team"
                                                   Foreground="#FFE082" FontSize="16" FontWeight="Bold"/>
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TeamOverlayBody" Foreground="#D4D4D4"
                                                   FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Border>
                            <Border x:Name="KidnapOverlay" Visibility="Collapsed"
                                Background="#CC0A0A0F" Panel.ZIndex="210">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#252530" BorderBrush="#6A6A80" BorderThickness="1"
                                    CornerRadius="10" Padding="16" Width="920" MaxHeight="680">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" x:Name="KidnapTitle"
                                               Text="Telepathic Alien Kidnappers"
                                               Foreground="#FFE082" FontSize="16" FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                        <TextBlock DockPanel.Dock="Top" x:Name="KidnapHint"
                                               Text="Name a card type, then pick a facedown card."
                                               Foreground="#9CDCFE" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                        <WrapPanel DockPanel.Dock="Top" x:Name="KidnapTypePanel" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnKidnapCancel" DockPanel.Dock="Bottom" Content="Cancel"
                                            Click="BtnKidnapCancel_Click" Padding="12,6"
                                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="KidnapCardsPanel"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" x:Name="PlayerHandStripBorder" Background="#2A3A32"
                        BorderBrush="#3A5A48" BorderThickness="0,1,0,0" Padding="4,2" MinHeight="118" Height="118">
                        <DockPanel>
                            <TextBlock x:Name="PlayerStripTitle" DockPanel.Dock="Top"
                                   Text="P1 HAND" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#B5CEA8" Margin="2,0,2,2"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PlayerStripPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- TABLE: full height, P2 top to status bar, P1 to window bottom -->
                <Border Grid.Column="1" x:Name="StackPanelBorder" Background="#1A1A1C"
                        BorderBrush="#1A1A1C" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" x:Name="OppTischZoneBorder"
                                Background="#252528" BorderBrush="#1A1A1C"
                                BorderThickness="0,0,0,1" Padding="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="P2 TABLE"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#8EC8D8" Margin="2,2,2,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="OppTablePermanentsPanel" Width="248"
                                               VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" x:Name="TischZoneBorder"
                                Background="#3E3E46" BorderBrush="#2E2E34"
                                BorderThickness="0,1,0,0" Padding="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="P1 TABLE"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#B5CEA8" Margin="2,2,2,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="TablePermanentsPanel" Width="248"
                                               VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <!-- Hidden legacy names for code that still references StackGrid/Title -->
                <StackPanel x:Name="StackGrid" Visibility="Collapsed" Width="0" Height="0"/>
                <TextBlock x:Name="StackTitle" Visibility="Collapsed"/>
            </Grid>

            <!-- Drag-Overlay -->
            <Canvas x:Name="DragLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="50"/>

            <!-- START-OVERLAY -->
            <Border x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Background="#CC101014"
                    Panel.ZIndex="100">
                <Border Background="#252528" CornerRadius="10" Padding="36,28"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#3A3A48" BorderThickness="1" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="Star Trek CCG 1E" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sandbox Table" FontSize="13" Foreground="#888"
                                   HorizontalAlignment="Center" Margin="0,4,0,22"/>
                        <Button Content="New game" Click="WelcomeNewGame_Click"
                                Height="40" Margin="0,0,0,10" FontSize="14" Cursor="Hand"
                                Background="#0E639C" Foreground="White" BorderThickness="0"/>
                        <Button Content="Load game…" Click="MenuLoadGame_Click"
                                Height="36" Margin="0,0,0,6" FontSize="13" Cursor="Hand"
                                Background="#333" Foreground="White" BorderThickness="0"/>
                        <Button Content="Quick game…" Click="MenuQuickGame_Click"
                                Height="36" Margin="0,0,0,6" FontSize="13" Cursor="Hand"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"
                                ToolTip="Pick two decks; seed phase is auto-resolved by the rules."/>
                        <StackPanel x:Name="NewGameOptions" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Game mode" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <RadioButton x:Name="ModeHotseat" Content="Hotseat" IsChecked="True"
                                             Foreground="#EEE" Margin="0,0,14,0" GroupName="GameMode"/>
                                <RadioButton x:Name="ModeNetwork" Content="Network" IsEnabled="False"
                                             Foreground="#666" Margin="0,0,14,0" GroupName="GameMode"
                                             ToolTip="Not available yet"/>
                                <RadioButton x:Name="ModeSingle" Content="Singleplayer (AI)" IsEnabled="False"
                                             Foreground="#666" GroupName="GameMode"
                                             ToolTip="Not available yet"/>
                            </StackPanel>
                            <TextBlock Text="Choose decks" Foreground="#AAA" FontSize="12" Margin="0,0,0,8"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Load deck…" Click="MenuLoadDeck_Click"
                                    Height="36" Margin="0,0,0,8" Cursor="Hand"
                                    Background="#3A3A48" Foreground="White" BorderThickness="0"/>
                            <Button Content="Create deck (Builder)…" Click="WelcomeDeckBuilder_Click"
                                    Height="36" Cursor="Hand"
                                    Background="#3A3A48" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- NAHANSICHT: Doppelklick auf Detailbild -->
            <Border x:Name="ZoomOverlay" Grid.ColumnSpan="2" Background="#E0101014"
                    Visibility="Collapsed" Panel.ZIndex="200"
                    MouseLeftButtonDown="ZoomOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1A1A1E" BorderBrush="#555" BorderThickness="2"
                        CornerRadius="8" Padding="12" MaxWidth="720" MaxHeight="920"
                        MouseLeftButtonDown="ZoomCard_MouseLeftButtonDown">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="ZoomCaption"
                                   Text="Click = close" Foreground="#888" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Image x:Name="ZoomImage" Stretch="Uniform"
                               MaxWidth="680" MaxHeight="860"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Cursor="Hand"/>
                    </DockPanel>
                </Border>
            </Border>

        </Grid>
    </DockPanel>
</Window>