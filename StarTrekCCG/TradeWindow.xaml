<Window x:Class="StarTrekCCG.TradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct trade"
        Height="680" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E22"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LobbyChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="16,14" Background="#1E1E22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Direct trade" Foreground="#EEE" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Offer cards this account already owns. The other account must accept. One trade, not a shop. A live match is rejected."
                           Foreground="#AAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Other account" Foreground="#CCC" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ToBox" Height="28" Padding="6,3" Margin="0,0,0,8"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
                <TextBlock Text="You give. One card id per line, then a quantity. Quantity 1 if omitted."
                           Foreground="#CCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox x:Name="GiveBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
                <TextBlock Text="You ask. Same lines. Leave empty to give only."
                           Foreground="#CCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox x:Name="AskBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="OfferButton" Content="Offer" Click="OfferButton_Click"
                            Height="30" MinWidth="88" Margin="0,0,8,0" Cursor="Hand"
                            Background="#3A3A48" Foreground="#EEE" BorderThickness="0"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"
                            Height="30" MinWidth="88" Cursor="Hand"
                            Background="#3A3A48" Foreground="#EEE" BorderThickness="0"/>
                </StackPanel>
                <TextBlock Text="Open offers" Foreground="#CCC" FontSize="12" Margin="0,0,0,4"/>
                <ListBox x:Name="OfferList" Height="110" Margin="0,0,0,8"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="AcceptButton" Content="Accept" Click="AcceptButton_Click"
                            Height="30" MinWidth="88" Margin="0,0,8,0" Cursor="Hand"
                            Background="#0E639C" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="DeclineButton" Content="Decline" Click="DeclineButton_Click"
                            Height="30" MinWidth="88" Cursor="Hand"
                            Background="#3A3A48" Foreground="#EEE" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="NoteText" Text="" Foreground="#EEE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Your pool" Foreground="#CCC" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="PoolBox" Height="140" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="#1E1E22" Foreground="#EEE" BorderBrush="#3A3A48"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
